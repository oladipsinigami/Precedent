# OpenRouter (OpenAI-compatible multi-model gateway) — https://openrouter.ai
OPENROUTER_API_KEY=
# Optional OpenRouter model override (defaults to openai/gpt-4o)
OPENROUTER_MODEL=openai/gpt-4o

# OpenAI (direct) — https://platform.openai.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# SpaceXAI (preferred when present) — https://console.x.ai
XAI_API_KEY=

# Experiential gateway for qwen3.8-27b (OpenAI Chat Completions compatible).
# Create one under Settings -> API Keys, then export EXPLABS_API_KEY=<key>.
# Preferred over BITGET_QWEN_API_KEY when set.
EXPLABS_API_KEY=

# Bitget hackathon Qwen credits (legacy fallback, used only when EXPLABS_API_KEY is absent)
BITGET_QWEN_API_KEY=

# Optional Bitget market data. Public tickers work without a key.
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_PASSPHRASE=

# Social providers
# X API v2 recent search bearer token (X Developer Portal, developer account).
X_BEARER_TOKEN=

# Search-enrichment provider for the news pillar.
# You.com Web Search API returns web AND news results in one call; the news
# section appears automatically for news-intent queries.
# New accounts start with $100 in free credits: https://you.com/platform
# Leave unset to skip the provider; the memo then reports the gap in its
# aggregated "Optional news coverage gaps" notice.
YDC_API_KEY=

# Alpha Vantage provider for market news and sentiment analysis (NEWS_SENTIMENT).
# Free API key (25 req/day): https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# SimFin provider for standardized fundamental data and financial statements.
# Free API key: https://www.simfin.com/
SIMFIN_API_KEY=

# Adanos provider for social sentiment (Reddit, X, news, Polymarket) & BuzzScore.
# Free API key: https://adanos.org/register
ADANOS_API_KEY=

# Bitget first-party data layer: the official `bitget-mcp-server` — no API key,
# free data tier, read-only US stock / ETF data. Bitget's own hackathon guide
# lists it as the core information layer for the AI Trading Desk track.
# Catalog: 22 equity entries (quotes, historical OHLCV, fundamentals, analyst
# estimates, 13F / insider ownership), 3 ETF, financial news search, sentiment.
# Override only if Bitget moves the endpoint.
BITGET_MCP_URL=https://agent.bitget.com/mcp

# Market-structure precompute bounds (scheduled job only).
# Default: top 500 unique rToken underlyings ranked by 24-hour USDT volume.
MARKET_STRUCTURE_UNIVERSE_LIMIT=500

# Minimum shared daily history per asset before admission (default 180 bars).
# The matrix uses the intersection of every asset's timestamps, so without this a
# single recently-listed name collapses the whole sample (69 sessions instead of
# a full trading year) and the correlation thresholds sit inside the noise.
MARKET_STRUCTURE_MIN_BARS=180

# Average-correlation cut for community clustering on market-mode-removed
# correlations (default 0.30). Higher = stricter merges, more and smaller groups.
MARKET_STRUCTURE_MIN_AVG_CORR=0.3

# Optional shared secret for POST /api/research (x-research-key header).
# Leave unset to keep the demo publicly accessible; a per-IP rate limit
# (10 req/min) is always enforced regardless.
RESEARCH_API_KEY=
