# SpaceXAI (preferred when present) — https://console.x.ai
XAI_API_KEY=

# Bitget hackathon Qwen credits (used when XAI_API_KEY is absent)
BITGET_QWEN_API_KEY=

# Optional Bitget market data. Public tickers work without a key.
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_PASSPHRASE=

# Social providers — ON HOLD for the demo (no keys configured). The sentiment
# pillar degrades gracefully with an explicit caveat instead of inventing posts,
# so Rosa runs keyless. To enable later, set one or both of:
# X API v2 recent search bearer token (X Developer Portal, developer account).
X_BEARER_TOKEN=
# YouTube Data API v3 key (Google Cloud Console, enable YouTube Data API v3;
# watch the daily quota — search.list is expensive).
YOUTUBE_API_KEY=
